    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-vue": "^10.11.1",
    "less": "^4.9.1",
    "npm-run-all2": "^9.0.3",
